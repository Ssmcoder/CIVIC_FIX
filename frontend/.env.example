# CrowdResolve frontend — copy to .env.local and adjust.

# Backend API base. In dev, leave as /api (vite proxies to VITE_API_PROXY_TARGET).
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8000

# OpenStreetMap tile URL — use a hosted provider (e.g. MapTiler/Geoapify)
# in production per tile-usage policy. Default: OSM standard tiles.
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Nominatim endpoint — point to a self-hosted instance for production.
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
